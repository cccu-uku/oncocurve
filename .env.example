# Optional: copy this file to `.env` (same folder) to change the defaults, then:
#   docker compose up -d
# `.env` is git-ignored.

# Image and version, e.g. a fixed release:
# ONCOCURVE_IMAGE=ghcr.io/cccu-uku/oncocurve:1.0.0
# or from Docker Hub:
# ONCOCURVE_IMAGE=docker.io/cccuuku/oncocurve:1.0.0
ONCOCURVE_IMAGE=

# Optional (only for local builds): commit hash written into the Excel export metadata, e.g. BUILD_COMMIT=$(git rev-parse --short HEAD)
BUILD_COMMIT=

# Optional: further sites allowed to embed ONCOcurve in an iframe, space-separated,
# e.g. FRAME_ANCESTORS=https://portal.example.org . Default: only ONCOcurve itself.
# Takes effect on the next restart (docker compose up -d).
FRAME_ANCESTORS=

# --- TLS / hostname ----------------------------------------------------------
# Typical on-prem setup: the server is reached over its IP, and an institute URL
# points to that IP. Pick ONE of the following for SITE_ADDRESS:
#
# 1) Self-signed (default, works immediately over the IP; one-time browser
#    warning). For permanent operation a hostname (2) or an institute
#    certificate (3) is recommended. Leave SITE_ADDRESS at ":443":
SITE_ADDRESS=:443
#
# 2) Automatic Let's Encrypt, ONLY if your institute hostname resolves DIRECTLY
#    to this server's IP (a real DNS A/AAAA record, not an HTTP redirect) and
#    ports 80+443 are reachable from the internet. Then set the hostname:
# SITE_ADDRESS=onco.uni-xy.de
#
# 3) Institutional certificate (no browser warning, no internet needed). Put the
#    cert + key on the host, uncomment the ":/certs:ro" volume line in
#    docker-compose.yml, and set:
# SITE_ADDRESS=onco.intern.uni-xy.de
# TLS_CERT=/certs/onco.crt
# TLS_KEY=/certs/onco.key
# CERT_DIR=/host/path/to/certs

TLS_CERT=
TLS_KEY=

# Note: if the institute URL only *redirects* (HTTP 301/302) to the raw IP,
# browsers end up on https://<IP>, which no public CA will certify. Use option
# (1) self-signed or (3) an institutional cert for the IP/hostname.
